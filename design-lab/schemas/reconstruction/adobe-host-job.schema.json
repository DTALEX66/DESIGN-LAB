{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-lab/adobe-host-job/v1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "rirHash", "runRoot", "artboard", "layers", "assets", "targets", "operations", "authorization"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "design-lab/adobe-host-job/v1"},
    "jobId": {"type": "string", "minLength": 1},
    "rirHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runRoot": {"type": "string", "minLength": 1},
    "artboard": {"type": "object"},
    "layers": {"type": "array"},
    "assets": {"type": "array"},
    "targets": {"type": "object"},
    "operations": {"type": "array"},
    "authorization": {"type": "object"}
  }
}
