{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-lab/photoshop-native-job/v1",
  "title": "Closed Photoshop native job (host contract)",
  "description": "The document src/design_lab/adapters/photoshop_com.py accepts for a from-scratch native dispatch. Each constraint restates a hand check that already ran before this file existed. The canvas AREA limit (width x height <= 25,000,000), the run-root containment, the not-exists-yet outputs and the image decode checks stay hand checks: a JSON Schema cannot multiply two fields, reach the filesystem, or open a PNG.",
  "type": "object",
  "required": ["schemaVersion", "jobId", "runRoot", "width", "height", "outputName", "previewName", "assets", "layers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "design-lab/photoshop-native-job/v1"},
    "jobId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"},
    "runRoot": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1, "maximum": 16383},
    "height": {"type": "integer", "minimum": 1, "maximum": 16383},
    "outputName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}\\.[pP][sS][dD]$"},
    "previewName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}\\.[pP][nN][gG]$"},
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {"type": "object", "required": ["id", "path"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "path": {"type": "string", "minLength": 1}}}
    },
    "layers": {"type": "array"}
  }
}
