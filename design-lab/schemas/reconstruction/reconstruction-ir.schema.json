{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packages/capabilities/reconstruction-ir/v1",
  "title": "Deterministic Reconstruction Intermediate Representation",
  "type": "object",
  "required": ["schemaVersion", "canvas", "layers"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "packages/capabilities/reconstruction-ir/v1"},
    "canvas": {"$ref": "#/$defs/canvas"},
    "layers": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "repairHistory": {"$ref": "#/$defs/repairHistory"},
    "confidence": {"$ref": "#/$defs/confidence"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "required": ["width", "height", "colorSpace"],
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "colorSpace": {"const": "srgb"},
        "background": {"$ref": "#/$defs/background"}
      }
    },
    "background": {
      "type": "object",
      "required": ["color", "recorded"],
      "additionalProperties": false,
      "properties": {
        "color": {"type": "string", "minLength": 1},
        "recorded": {"const": true}
      }
    },
    "bounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {"type": ["string", "null"]},
        "stroke": {"type": ["string", "null"]},
        "strokeWidth": {"type": "number", "minimum": 0},
        "fillRule": {"enum": ["nonzero", "evenodd"]},
        "lineCap": {"enum": ["butt", "round", "square"]},
        "lineJoin": {"enum": ["miter", "round", "bevel"]}
      }
    },
    "mask": {
      "type": "object",
      "required": ["id", "pathData", "operation", "opacity"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pathData": {"type": "string", "minLength": 1},
        "operation": {"enum": ["add", "subtract", "intersect", "exclude"]},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "geometry": {
      "type": "object",
      "required": ["pathData"],
      "additionalProperties": false,
      "properties": {
        "pathData": {"type": "string", "minLength": 1},
        "closed": {"type": "boolean"}
      }
    },
    "primitive": {
      "type": "object",
      "required": ["kind", "parameters"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["rect", "ellipse", "line", "polygon"]},
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x1": {"type": "number"},
            "y1": {"type": "number"},
            "x2": {"type": "number"},
            "y2": {"type": "number"},
            "rx": {"type": "number", "minimum": 0},
            "ry": {"type": "number", "minimum": 0},
            "points": {
              "type": "array",
              "items": {"$ref": "#/$defs/point"}
            }
          }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "textPayload": {
      "type": "object",
      "required": ["content", "disposition", "fontCandidates", "outlineFallback"],
      "additionalProperties": false,
      "properties": {
        "content": {"type": "string"},
        "disposition": {"enum": ["live", "outlined", "hybrid"]},
        "fontCandidates": {
          "type": "array",
          "items": {"$ref": "#/$defs/fontCandidate"}
        },
        "outlineFallback": {"$ref": "#/$defs/outlineFallback"}
      }
    },
    "fontCandidate": {
      "type": "object",
      "required": ["family", "weight", "style", "confidence"],
      "additionalProperties": false,
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 1, "maximum": 1000},
        "style": {"enum": ["normal", "italic", "oblique"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "outlineFallback": {
      "type": "object",
      "required": ["available", "pathData"],
      "additionalProperties": false,
      "properties": {
        "available": {"type": "boolean"},
        "pathData": {"type": ["string", "null"]}
      }
    },
    "rasterPayload": {
      "type": "object",
      "required": ["path", "crop", "alpha", "sourceMappings"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/projectPath"},
        "crop": {"$ref": "#/$defs/bounds"},
        "alpha": {"type": "number", "minimum": 0, "maximum": 1},
        "sourceMappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceMapping"}
        }
      }
    },
    "sourceMapping": {
      "type": "object",
      "required": ["sourceBounds", "targetBounds"],
      "additionalProperties": false,
      "properties": {
        "sourceBounds": {"$ref": "#/$defs/bounds"},
        "targetBounds": {"$ref": "#/$defs/bounds"}
      }
    },
    "repairHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "reason", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["score", "method"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sourceId", "evidence"],
      "additionalProperties": false,
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/projectPath"}}
      }
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "node": {
      "type": "object",
      "required": [
        "id", "type", "name", "opacity", "bounds", "inferred", "zOrder",
        "visible", "locked", "blendMode"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["group", "path", "primitive", "text", "raster"]},
        "name": {"type": "string"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "bounds": {"$ref": "#/$defs/bounds"},
        "inferred": {"type": "boolean"},
        "zOrder": {"type": "integer", "minimum": 0},
        "visible": {"type": "boolean"},
        "locked": {"type": "boolean"},
        "blendMode": {"enum": ["normal", "multiply", "screen", "overlay", "darken", "lighten"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "geometry": {"$ref": "#/$defs/geometry"},
        "primitive": {"$ref": "#/$defs/primitive"},
        "style": {"$ref": "#/$defs/style"},
        "masks": {"type": "array", "items": {"$ref": "#/$defs/mask"}},
        "text": {"$ref": "#/$defs/textPayload"},
        "raster": {"$ref": "#/$defs/rasterPayload"},
        "repairHistory": {"$ref": "#/$defs/repairHistory"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "group"}}},
          "then": {
            "required": ["children"],
            "not": {"anyOf": [
              {"required": ["geometry"]}, {"required": ["primitive"]},
              {"required": ["style"]}, {"required": ["masks"]},
              {"required": ["text"]}, {"required": ["raster"]}
            ]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "path"}}},
          "then": {
            "required": ["geometry", "style", "masks"],
            "not": {"anyOf": [
              {"required": ["children"]}, {"required": ["primitive"]},
              {"required": ["text"]}, {"required": ["raster"]}
            ]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "primitive"}}},
          "then": {
            "required": ["primitive", "style", "masks"],
            "not": {"anyOf": [
              {"required": ["children"]}, {"required": ["geometry"]},
              {"required": ["text"]}, {"required": ["raster"]}
            ]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "text"}}},
          "then": {
            "required": ["text"],
            "not": {"anyOf": [
              {"required": ["children"]}, {"required": ["geometry"]},
              {"required": ["primitive"]}, {"required": ["style"]},
              {"required": ["masks"]}, {"required": ["raster"]}
            ]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "raster"}}},
          "then": {
            "required": ["raster"],
            "not": {"anyOf": [
              {"required": ["children"]}, {"required": ["geometry"]},
              {"required": ["primitive"]}, {"required": ["style"]},
              {"required": ["masks"]}, {"required": ["text"]}
            ]}
          }
        }
      ]
    }
  }
}
