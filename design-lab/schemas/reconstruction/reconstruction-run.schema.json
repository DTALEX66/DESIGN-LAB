{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-lab/reconstruction-run/v1",
  "title": "Deterministic Reconstruction Run Contract",
  "type": "object",
  "required": [
    "schemaVersion", "runId", "jobId", "source", "profile", "canvasPolicy",
    "roots", "providerPolicy", "writeAuthorization", "registries", "lifecycle",
    "requestedOperations", "cancellationPolicy", "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "design-lab/reconstruction-run/v1"},
    "runId": {"$ref": "#/$defs/stableId"},
    "jobId": {"$ref": "#/$defs/stableId"},
    "source": {"$ref": "#/$defs/source"},
    "profile": {"enum": ["flat", "ui", "mixed", "photographic"]},
    "canvasPolicy": {"$ref": "#/$defs/canvasPolicy"},
    "roots": {"$ref": "#/$defs/roots"},
    "providerPolicy": {"$ref": "#/$defs/providerPolicy"},
    "writeAuthorization": {"$ref": "#/$defs/writeAuthorization"},
    "registries": {"$ref": "#/$defs/registries"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "requestedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["analyze", "reconstruct", "verify", "package", "readback"]}
    },
    "cancellationPolicy": {"$ref": "#/$defs/cancellationPolicy"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "source": {
      "type": "object",
      "required": ["sourceId", "path", "sha256", "profileMetadata", "normalizedReferenceTarget"],
      "additionalProperties": false,
      "properties": {
        "sourceId": {"$ref": "#/$defs/stableId"},
        "path": {"$ref": "#/$defs/projectPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "profileMetadata": {"$ref": "#/$defs/profileMetadata"},
        "normalizedReferenceTarget": {"$ref": "#/$defs/projectPath"}
      }
    },
    "profileMetadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "canvasPolicy": {
      "type": "object",
      "required": ["width", "height", "colorSpace", "globalCoordinates", "tilePolicy"],
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "colorSpace": {"const": "srgb"},
        "globalCoordinates": {"enum": ["canvas", "source-pixel"]},
        "tilePolicy": {"$ref": "#/$defs/tilePolicy"}
      }
    },
    "tilePolicy": {
      "type": "object",
      "required": ["enabled", "tileWidth", "tileHeight", "overlap"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "tileWidth": {"type": "integer", "minimum": 1},
        "tileHeight": {"type": "integer", "minimum": 1},
        "overlap": {"type": "integer", "minimum": 0}
      }
    },
    "roots": {
      "type": "object",
      "required": ["runtime", "evidence"],
      "additionalProperties": false,
      "properties": {
        "runtime": {"$ref": "#/$defs/projectPath"},
        "evidence": {"$ref": "#/$defs/projectPath"}
      }
    },
    "providerPolicy": {
      "type": "object",
      "required": ["defaultProvider", "providerAllowlist", "selectedProvider", "remoteConsents"],
      "additionalProperties": false,
      "properties": {
        "defaultProvider": {"const": "local"},
        "providerAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": {"const": "local"},
          "items": {"$ref": "#/$defs/stableId"}
        },
        "selectedProvider": {"$ref": "#/$defs/stableId"},
        "remoteConsents": {
          "type": "array",
          "items": {"$ref": "#/$defs/remoteConsent"}
        }
      }
    },
    "remoteConsent": {
      "type": "object",
      "required": ["path", "sha256", "provider", "consented"],
      "additionalProperties": false,
      "properties": {
        "path": {"$ref": "#/$defs/projectPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "provider": {"$ref": "#/$defs/stableId"},
        "consented": {"const": true}
      }
    },
    "writeAuthorization": {
      "type": "object",
      "required": ["authorizationId", "jobId", "runId", "targets", "issuedAt", "expiresAt", "state"],
      "additionalProperties": false,
      "properties": {
        "authorizationId": {"$ref": "#/$defs/stableId"},
        "jobId": {"$ref": "#/$defs/stableId"},
        "runId": {"$ref": "#/$defs/stableId"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/projectPath"}
        },
        "issuedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "state": {"const": "authorized"}
      }
    },
    "registries": {
      "type": "object",
      "required": ["toolRegistry", "modelRegistry"],
      "additionalProperties": false,
      "properties": {
        "toolRegistry": {"$ref": "#/$defs/projectPath"},
        "modelRegistry": {"$ref": "#/$defs/projectPath"}
      }
    },
    "lifecycleState": {
      "enum": ["created", "authorized", "running", "completed", "packaged", "readback-verified", "cancelled", "failed"]
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "history"],
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/lifecycleState"},
        "history": {
          "type": "array",
          "items": {"$ref": "#/$defs/lifecycleTransition"}
        }
      }
    },
    "lifecycleTransition": {
      "type": "object",
      "required": ["from", "to", "at"],
      "additionalProperties": false,
      "properties": {
        "from": {"$ref": "#/$defs/lifecycleState"},
        "to": {"$ref": "#/$defs/lifecycleState"},
        "at": {"type": "string", "format": "date-time"}
      }
    },
    "cancellationPolicy": {
      "type": "object",
      "required": ["cancelable", "resume", "checkpointPath"],
      "additionalProperties": false,
      "properties": {
        "cancelable": {"type": "boolean"},
        "resume": {"enum": ["forbidden", "checkpoint", "restart"]},
        "checkpointPath": {"$ref": "#/$defs/projectPath"}
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "path"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "kind": {"enum": ["normalized-source", "vector-output", "package", "evidence", "readback", "checkpoint"]},
        "path": {"$ref": "#/$defs/projectPath"}
      }
    }
  }
}
