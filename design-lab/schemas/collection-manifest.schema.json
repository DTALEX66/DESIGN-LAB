{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/collection-manifest.schema.json",
  "title": "Collection Manifest — 外置资料人工摄取清单",
  "description": "DL-KNW-006：外置资料只能通过人工创建的 Collection Manifest 摄取。禁止默认扫描外置资料库根目录（如 D:\\All projects\\Design assets\\**）；selectedPaths 必须为显式相对路径。",
  "type": "object",
  "required": [
    "collectionId",
    "displayName",
    "selectedPaths",
    "intendedUse",
    "rightsReviewRequired",
    "outputTargets",
    "createdBy",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "collectionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "externalLibraryAlias": {
      "type": "string",
      "description": "local-profile 中的库别名（如 design-assets），不得为 Windows 绝对路径。"
    },
    "selectedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "外置库内的显式相对路径（人工选择）。根扫描通配（** 或根目录本身）由 intake 脚本拒绝。"
    },
    "intendedUse": {
      "type": "string",
      "minLength": 1
    },
    "rightsReviewRequired": {
      "type": "boolean",
      "description": "true 时未经人工权利复核不得进入 Safe Extraction。"
    },
    "outputTargets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "$schema": {
      "type": "string"
    }
  }
}
