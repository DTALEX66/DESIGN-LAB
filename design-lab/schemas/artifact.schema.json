{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/artifact.json",
  "title": "Artifact — 可编辑源文件/导出文件/派生产物",
  "type": "object",
  "required": [
    "artifact_id",
    "kind",
    "path",
    "format"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "editable-source",
        "export",
        "derived"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 8
    },
    "producedBy": {
      "type": "string",
      "description": "ToolRun id 或人工来源"
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
