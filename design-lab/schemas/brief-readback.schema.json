{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/brief-readback.json",
  "title": "BriefReadback — 设计简报的读回信封（GET /api/projects/<id>/briefs）",
  "description": "What the brief route actually answers with, and nothing more. This is the readback contract for the versioned brief record the design layer persists (title, goals, constraints, references, spec hash, version chain pointer); it is NOT design-lab/schemas/design-brief.schema.json, which declares a content model (discipline, objective, audience, deliverables, success_metrics, brand_assets) that no code in this repository stores, serves or validates. That divergence is an open owner decision; this file exists so the payload a person reads back through the Workbench is a checked boundary rather than a shape only a page's TypeScript interface describes.",
  "type": "object",
  "required": ["schemaVersion", "briefs", "next_cursor"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "design-lab/brief-readback/v1"
    },
    "briefs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/brief"
      }
    },
    "next_cursor": {
      "type": ["string", "null"],
      "pattern": "^brief-[0-9a-f]{32}$"
    }
  },
  "$defs": {
    "brief": {
      "type": "object",
      "required": ["brief_id", "title", "goals", "constraints", "reference_asset_ids",
                   "spec_sha256", "version", "superseded_by", "created_at"],
      "additionalProperties": false,
      "properties": {
        "brief_id": {
          "type": "string",
          "pattern": "^brief-[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": ["string", "null"]
        },
        "reference_asset_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "superseded_by": {
          "type": ["string", "null"],
          "pattern": "^brief-[0-9a-f]{32}$"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
