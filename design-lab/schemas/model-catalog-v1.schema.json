{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/model-catalog-v1.schema.json",
  "title": "Model catalog v1 (the two registries the desktop picker reads, kept side by side)",
  "$comment": "Emitter: src/design_lab/model_catalog.py (catalog), served by GET /api/models and read by #/models in apps/workbench/shell.ts. The owner un-locked model choice on 2026-10-20 (「不锁死 做好菜单导航和接口 用户自行选择本地或者是云端模型」), and a picker needs one honest document to choose from. It is a PROJECTION of two registries that share no key, validated here for the first time: each model row is copied from design-lab/readiness/model-radar.json, whose own contract is design-lab/schemas/readiness-model-radar.schema.json (validated on load by readiness/model_radar.validate_registry), and each endpoint row is copied from design-lab/config/provider-capabilities.json, bound by design-lab/schemas/provider-capability.schema.json. Both row shapes are restated rather than $ref'd because the projection drops fields (model rows lose local_path, asset_index_ids, hash_source, qualified_by, notes; endpoint rows lose schemaVersion, model_ref, policy_note, license_risk_note) -- claiming the source document here would say a reader sees the whole record. `placement` is closed to the three words the histogram counts, which is NARROWER than the radar's own source.kind enum (it also admits `modelscope`): a registry row with a fourth placement is a deliberate widening of three contracts at once (PLACEMENTS here, design-lab/schemas/model-selection-v1.schema.json snapshot.placement, and the state store's CHECK), and design-lab/tests/test_model_catalog.py is what convicts the row first. The fail-closed claims the page renders are pinned as invariants below, not left as prose: a count of zero qualified or zero default-enabled cannot coexist with a row that claims either.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observed_at",
    "sources",
    "hardware",
    "policy",
    "counts",
    "models",
    "endpoints",
    "join",
    "selection",
    "claims_not_made"
  ],
  "properties": {
    "schemaVersion": {"const": "design-lab/model-catalog/v1"},
    "observed_at": {"type": "string", "minLength": 1},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "endpoints"],
      "properties": {
        "models": {"const": "design-lab/readiness/model-radar.json"},
        "endpoints": {"const": "design-lab/config/provider-capabilities.json"}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_vram_mib", "gpu", "source"],
      "properties": {
        "available_vram_mib": {"type": "integer", "minimum": 1},
        "gpu": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "policy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "endpoints", "qualified_local", "default_enabled_true",
                   "weights_recorded", "placement"],
      "properties": {
        "models": {"type": "integer", "minimum": 0},
        "endpoints": {"type": "integer", "minimum": 0},
        "qualified_local": {"type": "integer", "minimum": 0},
        "default_enabled_true": {"type": "integer", "minimum": 0},
        "weights_recorded": {"type": "integer", "minimum": 0},
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local", "huggingface", "vendor"],
          "properties": {
            "local": {"type": "integer", "minimum": 0},
            "huggingface": {"type": "integer", "minimum": 0},
            "vendor": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "endpoints": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "reason"],
      "properties": {
        "key": {"const": null},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules", "transport", "executed"],
      "properties": {
        "mode": {"const": "USER_CHOSEN_NOT_LOCKED"},
        "rules": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "transport": {"const": "NOT_CONNECTED"},
        "executed": {"const": false}
      }
    },
    "claims_not_made": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "$comment": "The readiness claims cannot disagree with the rows they summarise: this is the page's only defence against a green 'ready' chip the registry does not support.",
      "if": {"properties": {"counts": {"properties": {"qualified_local": {"const": 0}},
                                        "required": ["qualified_local"]}},
             "required": ["counts"]},
      "then": {"properties": {"models": {"items": {"properties": {
        "radar_state": {"not": {"const": "QUALIFIED_LOCAL"}}}}}}}
    },
    {
      "if": {"properties": {"counts": {"properties": {"default_enabled_true": {"const": 0}},
                                        "required": ["default_enabled_true"]}},
             "required": ["counts"]},
      "then": {"properties": {"models": {"items": {"properties": {
        "default_enabled": {"not": {"const": true}}}}}}}
    },
    {
      "if": {"properties": {"counts": {"properties": {"weights_recorded": {"const": 0}},
                                        "required": ["weights_recorded"]}},
             "required": ["counts"]},
      "then": {"properties": {"models": {"items": {"properties": {
        "weights_recorded": {"const": 0}}}}}}
    }
  ],
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "family", "placement", "source_ref", "radar_state", "machine_state",
                   "hardware_fit", "vram_gib_required", "commercial_use", "license_id",
                   "default_enabled", "weights_recorded", "blocking_reason", "evidence_ref"],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "family": {"enum": ["image-generation", "video-generation", "upscaling", "segmentation",
                           "ocr", "asr", "tts", "3d"]},
        "placement": {"enum": ["local", "huggingface", "vendor"]},
        "source_ref": {"type": "string", "minLength": 1},
        "radar_state": {"enum": ["WATCH", "EVALUATING", "QUALIFIED_LOCAL", "REJECTED",
                                 "BLOCKED_BY_LICENSE"]},
        "machine_state": {"enum": ["ABSENT", "METADATA_ONLY", "WEIGHTS_COMPLETE", "LOAD_VERIFIED",
                                   "INFERENCE_VERIFIED"]},
        "hardware_fit": {"enum": ["FITS", "TIGHT", "EXCEEDS", "UNKNOWN"]},
        "vram_gib_required": {"type": ["integer", "null"], "minimum": 1},
        "commercial_use": {"enum": ["PERMITTED", "RESTRICTED", "UNKNOWN"]},
        "license_id": {"type": "string", "minLength": 1},
        "default_enabled": {"type": "boolean"},
        "weights_recorded": {"type": "integer", "minimum": 0},
        "blocking_reason": {"type": ["string", "null"]},
        "evidence_ref": {"type": ["string", "null"]}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "endpoint_ref", "capabilities", "local_first", "license",
                   "license_risk", "evidence_level", "source"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "endpoint_ref": {"type": "string", "pattern": "^provider:"},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "local_first": {"type": ["boolean", "null"]},
        "license": {"enum": ["MIT", "Apache-2.0", "BSD-3-Clause", "MPL-2.0", "GPL-2.0", "GPL-3.0",
                             "CC-BY-NC-SA-4.0", "proprietary", "unverified"]},
        "license_risk": {"type": ["string", "null"]},
        "evidence_level": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
