{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/method-card.json",
  "title": "MethodCard — 可复用设计方法（匿名，不以在世创作者名义模仿）",
  "type": "object",
  "required": [
    "method_id",
    "name",
    "steps",
    "attribution"
  ],
  "properties": {
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "attribution": {
      "type": "string",
      "description": "匿名方法来源（禁止以在世创作者名义模仿）"
    },
    "sourceRef": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
