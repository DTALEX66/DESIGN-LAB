{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/target-profile-axes-v1.schema.json",
  "title": "Target Profile Axes V1 (the closed vocabulary the panel builds its selects from)",
  "$comment": "DL-KB-10 depends on this document. The panel must not hand-copy these lists into TypeScript, because a second table would let the screen offer a word the service refuses -- the same reason the assistance plan serves its output types. `measured_fields` is served with the vocabulary so the screen can show 「本项目未测试」 as a count it read from the service rather than a label it decided on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capability_fields", "axes", "provenance_kinds", "field_states",
               "support_states", "entry_kinds", "validate_dimensions", "verdicts", "software",
               "task_modes", "measured_fields", "measured_note", "executable"],
  "properties": {
    "schemaVersion": {"const": "design-lab/target-profile-axes/v1"},
    "capability_fields": {"type": "array", "minItems": 13, "maxItems": 13,
                          "items": {"type": "object", "additionalProperties": false,
                                    "required": ["key", "label"],
                                    "properties": {"key": {"type": "string", "minLength": 1},
                                                   "label": {"type": "string", "minLength": 1}}}},
    "axes": {"type": "array", "minItems": 7, "maxItems": 7,
             "items": {"type": "object", "additionalProperties": false,
                       "required": ["key", "label"],
                       "properties": {"key": {"type": "string", "minLength": 1},
                                      "label": {"type": "string", "minLength": 1}}}},
    "provenance_kinds": {"type": "array", "minItems": 5, "maxItems": 5,
                         "items": {"type": "object", "additionalProperties": false,
                                   "required": ["key", "label"],
                                   "properties": {"key": {"type": "string", "minLength": 1},
                                                  "label": {"type": "string", "minLength": 1}}}},
    "field_states": {"type": "array", "minItems": 3, "maxItems": 3,
                     "items": {"enum": ["DOCUMENTED", "NOT_DOCUMENTED", "UNKNOWN"]}},
    "support_states": {"type": "array", "minItems": 4, "maxItems": 4,
                       "items": {"enum": ["DOCUMENTED_CLAIM", "CONDITIONAL", "UNREACHED",
                                          "USER_DRAFT"]}},
    "entry_kinds": {"type": "array", "minItems": 5, "maxItems": 5,
                    "items": {"enum": ["API", "WEB_APP", "DESKTOP_CLIENT", "COMFYUI_NODE",
                                       "UNSTATED"]}},
    "validate_dimensions": {"type": "array", "minItems": 9, "maxItems": 9,
                            "items": {"type": "string", "minLength": 1}},
    "verdicts": {"type": "array", "minItems": 4, "maxItems": 4,
                 "items": {"enum": ["DOCUMENTED_SUPPORT", "DOCUMENTED_NOT_SUPPORT", "UNKNOWN",
                                    "NOT_APPLICABLE"]}},
    "software": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "task_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "measured_fields": {"type": "integer", "minimum": 0},
    "measured_note": {"type": "string", "minLength": 1},
    "executable": {"const": false}
  }
}
