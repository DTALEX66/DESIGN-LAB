{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/research-finding.json",
  "title": "ResearchFinding — 可引用研究结论（非设计规则）",
  "type": "object",
  "required": [
    "finding_id",
    "claim",
    "sourceRefs"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "speculative"
      ]
    },
    "notDesignRule": {
      "type": "boolean",
      "const": true,
      "description": "研究结论不能直接冒充设计规则"
    }
  },
  "additionalProperties": false
}
