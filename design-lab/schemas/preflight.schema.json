{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/preflight.schema.json",
  "title": "Preflight Contract V2 (production checks)",
  "description": "生产预检契约：required_checks 结构（id/severity/tool/standard_ref）+ 机器可读报告。印刷/数字/视频 profiles。",
  "type": "object",
  "required": [
    "preflight_id",
    "schemaVersion",
    "profile",
    "required_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "preflight_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/preflight/v2"
    },
    "profile": {
      "enum": [
        "print",
        "digital",
        "video",
        "ui"
      ]
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "tool"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "high",
              "medium",
              "low"
            ]
          },
          "tool": {
            "type": "string"
          },
          "standard_ref": {
            "type": "string",
            "description": "标准引用（PDF/X、WCAG 等）"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "warning"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
