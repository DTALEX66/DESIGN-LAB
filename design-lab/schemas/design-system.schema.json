{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/design-system.json",
  "title": "DesignSystem — tokens、type、grid、components、asset contracts",
  "type": "object",
  "required": [
    "system_id",
    "name",
    "tokens"
  ],
  "properties": {
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "typography": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "grid": {
      "type": "object"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assetContracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
