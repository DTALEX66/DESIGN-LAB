{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/jury-record.json",
  "title": "JuryRecord — Visual Quality Jury 评审记录",
  "type": "object",
  "required": ["jury_id", "boundTreeSha", "target", "axes", "deterministic", "humanReview", "evidence", "verdict"],
  "properties": {
    "jury_id": {"type": "string", "minLength": 1},
    "boundTreeSha": {"type": "string", "minLength": 8},
    "target": {"type": "string", "minLength": 1},
    "axes": {
      "type": "object",
      "required": ["antiSlop", "layout", "material", "readability", "commercial"],
      "properties": {
        "antiSlop": {"type": "integer", "minimum": 1, "maximum": 5},
        "layout": {"type": "integer", "minimum": 1, "maximum": 5},
        "material": {"type": "integer", "minimum": 1, "maximum": 5},
        "readability": {"type": "integer", "minimum": 1, "maximum": 5},
        "commercial": {"type": "integer", "minimum": 1, "maximum": 5}
      },
      "additionalProperties": false
    },
    "deterministic": {
      "type": "object",
      "required": ["check", "result", "runAt"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["OK", "FAIL"]},
        "runAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "humanReview": {
      "type": "object",
      "required": ["reviewer", "date", "verdict"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "date": {"type": "string"},
        "verdict": {"type": "string", "enum": ["PASS", "REVISE", "REJECT"]},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "artifact"],
        "properties": {
          "level": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
          "artifact": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "verdict": {"type": "string", "enum": ["PASS", "REVISE", "REJECT"]}
  },
  "additionalProperties": false
}
