{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/tool-action-plan.schema.json",
  "title": "Tool-neutral Action Plan",
  "type": "object",
  "required": ["planId", "designIrRef", "permission", "dryRun", "actions", "rollback"],
  "additionalProperties": false,
  "properties": {
    "planId": {"type": "string", "minLength": 1},
    "designIrRef": {"type": "string", "pattern": "^design-ir://"},
    "permission": {"enum": ["not-requested", "requested", "granted", "denied"]},
    "dryRun": {"type": "boolean"},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
    "rollback": {"$ref": "#/$defs/rollback"}
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "capability", "target", "params", "preconditions", "risk", "backup", "expectedReadback"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
        "target": {"type": "string", "minLength": 1},
        "params": {"type": "object"},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "risk": {"enum": ["low", "medium", "high"]},
        "backup": {"type": "string", "minLength": 1},
        "expectedReadback": {"type": "object", "minProperties": 1}
      }
    },
    "rollback": {
      "type": "object",
      "required": ["strategy", "verification"],
      "additionalProperties": false,
      "properties": {"strategy": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}}
    }
  }
}
