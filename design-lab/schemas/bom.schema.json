{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/bom.json",
  "title": "BOM — 生产交付资产清单",
  "type": "object",
  "required": ["version", "handoff", "items", "provenance"],
  "properties": {
    "version": {"type": "string"},
    "generated_at": {"type": "string"},
    "project": {"type": "string"},
    "handoff": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "format", "sha256", "source", "license"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["editable-source", "export", "derived"]},
          "format": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "minLength": 8},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": ["boundTreeSha", "generatedAt", "environment", "toolVersion", "inputHash"],
      "properties": {
        "boundTreeSha": {"type": "string", "minLength": 8},
        "generatedAt": {"type": "string", "format": "date-time"},
        "environment": {"type": "string", "minLength": 1},
        "toolVersion": {"type": "string", "minLength": 1},
        "inputHash": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
