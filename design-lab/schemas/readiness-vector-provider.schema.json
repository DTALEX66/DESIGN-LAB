{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/readiness-vector-provider.json",
  "title": "DESIGN-LAB vector provider declaration (DL-P1-120)",
  "description": "Structural declaration of the vectorisation provider surface. Every capability is declared, none is supported while no tracer is admitted; a supported capability requires live trace evidence that this build does not have.",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "adapter_id",
    "adapter_version",
    "adapter_type",
    "lifecycle",
    "backend_kinds",
    "capabilities",
    "execution_state",
    "evidence_level"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "design-lab/vector-provider-declaration/v1"},
    "task_id": {"const": "DL-P1-120"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "adapter_type": {"const": "provider"},
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["probe", "prepare", "execute", "observe", "readback", "rollback"]}
    },
    "backend_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["external-tracer", "in-repo-tracer", "manual-vector-native", "readback"]}
    },
    "tracer_id": {"type": ["string", "null"]},
    "tracer_path": {
      "type": ["string", "null"],
      "description": "Reference only. A path is documentation, never a capability, and never an E: location."
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["api_id", "kind", "supported", "declared", "reason"],
        "additionalProperties": false,
        "properties": {
          "api_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["external-tracer", "in-repo-tracer", "manual-vector-native", "readback"]},
          "declared": {"type": "boolean"},
          "supported": {
            "type": "boolean",
            "description": "May only be true with live trace evidence; a structural declaration keeps it false."
          },
          "reason": {"type": "string", "minLength": 1},
          "note": {"type": "string"},
          "evidence_ref": {
            "type": ["string", "null"],
            "description": "Required (non-empty) when supported is true; must reference a live trace run."
          }
        }
      }
    },
    "execution_state": {"const": "NOT_EXECUTED_STRUCTURAL_ONLY"},
    "evidence_level": {"enum": ["E0", "E1"]}
  }
}
