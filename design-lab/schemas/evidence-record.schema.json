{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/evidence-record.schema.json",
  "title": "EvidenceRecord — E0–E5 证据记录",
  "type": "object",
  "required": ["evidenceId", "level", "boundTreeSha", "owner", "timestamp", "command", "environment", "inputHash", "result", "approver"],
  "additionalProperties": false,
  "properties": {
    "evidenceId": {"type": "string", "minLength": 1},
    "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "boundTreeSha": {"type": "string", "minLength": 7},
    "owner": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "host": {
      "title": "HostProvenance — 真实宿主运行面取证（E3 必需）",
      "description": "E3 的宿主来源：哪个产品/版本、哪个适配器/版本/哈希、如何调用、读回了什么、产物哈希。没有这一块就不存在 E3。",
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "productVersion", "adapterId", "adapterVersion", "adapterSha256", "invocation", "readback", "artifacts"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "productVersion": {"type": "string", "minLength": 1},
        "adapterId": {"type": "string", "minLength": 1},
        "adapterVersion": {"type": "string", "minLength": 1},
        "adapterSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "invocation": {"type": "string", "minLength": 1},
        "readback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  },
  "if": {"properties": {"level": {"const": "E3"}}, "required": ["level"]},
  "then": {"required": ["host"]}
}
