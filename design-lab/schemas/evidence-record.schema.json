{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/evidence-record.schema.json",
  "title": "EvidenceRecord — E0–E5 证据记录",
  "type": "object",
  "required": ["evidenceId", "level", "boundTreeSha", "owner", "timestamp", "command", "environment", "inputHash", "result", "approver"],
  "additionalProperties": false,
  "properties": {
    "evidenceId": {"type": "string", "minLength": 1},
    "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "boundTreeSha": {"type": "string", "minLength": 7},
    "owner": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "command": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1}
  }
}
