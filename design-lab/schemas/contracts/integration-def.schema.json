{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/integration-def.schema.json",
  "title": "integration-def",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "integration_id",
    "schemaVersion",
    "executable_ref",
    "capabilities",
    "permissions"
  ],
  "properties": {
    "integration_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/integration-def/v1"
    },
    "executable_ref": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
