{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/run-event.schema.json",
  "title": "run-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schemaVersion",
    "job_id",
    "event_type",
    "at"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/run-event/v1"
    },
    "job_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
