{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/permission-manifest.schema.json",
  "title": "permission-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "schemaVersion",
    "permissions"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/permission-manifest/v1"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
