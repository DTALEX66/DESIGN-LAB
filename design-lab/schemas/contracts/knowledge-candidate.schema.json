{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/knowledge-candidate.schema.json",
  "title": "knowledge-candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "schemaVersion",
    "knowledge_type",
    "state"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/knowledge-candidate/v1"
    },
    "knowledge_type": {
      "type": "string"
    },
    "state": {
      "enum": [
        "candidate",
        "review",
        "approved"
      ]
    }
  }
}
