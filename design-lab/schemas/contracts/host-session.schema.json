{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/host-session.schema.json",
  "title": "host-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "schemaVersion",
    "host_id",
    "session_kind",
    "session_mode"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/host-session/v1"
    },
    "host_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "session_kind": {
      "enum": [
        "LOCAL_GUI",
        "LOCAL_HEADLESS",
        "REMOTE_SERVICE"
      ]
    },
    "session_mode": {
      "enum": [
        "ATTACH_EXISTING",
        "LAUNCH_OWNED"
      ]
    },
    "ownership": {
      "enum": [
        "DESIGN_OWNED",
        "USER_OWNED",
        "UNKNOWN"
      ]
    }
  }
}
