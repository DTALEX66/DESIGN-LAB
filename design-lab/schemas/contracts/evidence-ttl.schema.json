{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/evidence-ttl.schema.json",
  "title": "evidence-ttl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "schemaVersion",
    "ttl_days"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/evidence-ttl/v1"
    },
    "ttl_days": {
      "type": "integer",
      "minimum": 1
    }
  }
}
