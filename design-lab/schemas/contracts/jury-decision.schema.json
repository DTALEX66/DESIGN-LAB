{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/jury-decision.schema.json",
  "title": "jury-decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jury_id",
    "schemaVersion",
    "score",
    "decision"
  ],
  "properties": {
    "jury_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/jury-decision/v1"
    },
    "score": {
      "type": "number"
    },
    "decision": {
      "enum": [
        "pass",
        "fail",
        "revision"
      ]
    }
  }
}
