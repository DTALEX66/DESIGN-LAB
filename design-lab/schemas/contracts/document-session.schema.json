{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/document-session.schema.json",
  "title": "document-session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "schemaVersion",
    "session_id"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/document-session/v1"
    },
    "session_id": {
      "type": "string"
    },
    "dirty": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "true/false or NOT_APPLICABLE/UNKNOWN"
    },
    "checkpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_state": {
      "type": "string",
      "description": "ACTIVE/RECONCILING/HUMAN_OWNED/RELEASED/BLOCKED"
    }
  }
}
