{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/asset-manifest.schema.json",
  "title": "asset-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "schemaVersion",
    "assets"
  ],
  "properties": {
    "manifest_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/asset-manifest/v1"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
