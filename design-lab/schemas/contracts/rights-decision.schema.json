{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/rights-decision.schema.json",
  "title": "rights-decision",
  "description": "A rights decision with enum-constrained decision (F03: free-string status rejected), actor, and timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "schemaVersion",
    "use_scope",
    "decision",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "design-lab/rights-decision/v1"
    },
    "use_scope": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "APPROVED",
        "DENIED",
        "PENDING_REVIEW",
        "BLOCKED_BY_LICENSE"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "territory": {
      "type": "string",
      "minLength": 1
    },
    "license_ref": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  }
}
