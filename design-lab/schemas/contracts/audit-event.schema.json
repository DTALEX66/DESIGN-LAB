{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/audit-event.schema.json",
  "title": "audit-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "schemaVersion",
    "actor",
    "action",
    "at"
  ],
  "properties": {
    "audit_id": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-lab/audit-event/v1"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
