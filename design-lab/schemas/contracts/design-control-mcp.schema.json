{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/design-control-mcp.schema.json",
  "title": "DesignControlMCP",
  "type": "object",
  "required": [
    "schemaVersion",
    "allowed_tools",
    "forbidden"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "design-lab/design-control-mcp/v1"
    },
    "allowed_tools": {
      "const": [
        "design_probe",
        "design_inspect",
        "design_plan",
        "design_execute_recipe",
        "design_observe",
        "design_preview",
        "design_readback",
        "design_undo",
        "design_export",
        "design_handoff"
      ]
    },
    "forbidden": {
      "const": [
        "execute_js",
        "run_macro_text",
        "shell",
        "arbitrary_path",
        "arbitrary_menu_id",
        "coordinate_click"
      ]
    }
  }
}
