{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/tool-run.json",
  "title": "ToolRun — 可审计的 Adapter 执行记录",
  "type": "object",
  "required": [
    "run_id",
    "adapter_id",
    "tool",
    "status",
    "timestamp"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "success",
        "failed",
        "blocked"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "outputRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    }
  },
  "additionalProperties": false
}
