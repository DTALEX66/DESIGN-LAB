{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/prompt-composition-v1.schema.json",
  "title": "Prompt composition v1 (the document POST /api/projects/<id>/prompts derives)",
  "$comment": "Emitter: src/design_lab/prompt_intelligence.py (PromptIntelligence.compose). The route answers with a readback envelope whose `document` member is this shape, so this contract binds the document and the envelope is the transport. Every `sections[].text` is either a stored field (source.kind 'stored', carrying the brief/direction id, version and spec_sha256 it was read from) or a framing label this module owns (source.kind 'framing'). The schema therefore forbids the failure mode that matters: prose in a prompt that has no provenance and is not a label. `unknown` is required and non-empty by rule of the emitter, because a prompt that silently omits audience, brand assets or copy reads as if those were considered. `model.executed` is const false: nothing in this repository runs a model to compose a prompt, and a writable true would let a composed document claim model generation. `composition_id` is a digest of the inputs, so two calls over the same stored records produce byte-identical documents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "composition_id",
    "project_id",
    "target",
    "prompt_text",
    "sections",
    "observed",
    "framing",
    "unknown",
    "model",
    "claims_not_made"
  ],
  "properties": {
    "schemaVersion": {"const": "design-lab/prompt-composition/v1"},
    "composition_id": {"type": "string", "pattern": "^prompt-[0-9a-f]{32}$"},
    "project_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "target": {"type": "string", "enum": ["image-generation", "video-generation", "3d"]},
    "prompt_text": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "source"],
        "properties": {
          "kind": {"type": "string", "enum": ["target", "subject", "goal", "constraint", "stance", "style", "colour", "typography"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "source": {"$ref": "#/$defs/source"}
        }
      }
    },
    "observed": {"type": "array", "items": {"$ref": "#/$defs/storedSource"}},
    "framing": {"type": "array", "items": {"$ref": "#/$defs/framingSource"}},
    "unknown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {"type": "string", "minLength": 1, "maxLength": 80},
          "reason": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "executed"],
      "properties": {
        "selected": {"type": ["object", "null"]},
        "executed": {"const": false}
      }
    },
    "claims_not_made": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "source": {
      "oneOf": [{"$ref": "#/$defs/storedSource"}, {"$ref": "#/$defs/framingSource"}]
    },
    "storedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "spec_sha256"],
      "properties": {
        "kind": {"const": "stored"},
        "brief_id": {"type": "string", "pattern": "^brief-[0-9a-f]{32}$"},
        "direction_id": {"type": "string", "pattern": "^direction-[0-9a-f]{32}$"},
        "version": {"type": "integer", "minimum": 1},
        "spec_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "anyOf": [{"required": ["brief_id"]}, {"required": ["direction_id"]}]
    },
    "framingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rule"],
      "properties": {
        "kind": {"const": "framing"},
        "rule": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    }
  }
}
