{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/capability-index.json",
  "title": "CapabilityIndex — 能力索引（generate_capability_indexes.py 产出）",
  "type": "object",
  "required": ["$schema", "version", "generated_at", "capability_count", "capabilities"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string"},
    "generated_at": {"type": "string"},
    "capability_count": {"type": "integer", "minimum": 0},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "label", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "minLength": 8}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
