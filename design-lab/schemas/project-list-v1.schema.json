    "does_not_say": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
