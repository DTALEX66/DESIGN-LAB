{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/design-action.schema.json",
  "title": "DesignAction (Action Language)",
  "description": "原子动作词汇（move/align/set-font/…）：DesignCommand.args 的规范化层。动作不绑定具体工具/模型名（中立性）。",
  "type": "object",
  "required": [
    "action",
    "target",
    "params"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "description": "layer:// 或 IR 节点 ref"
    },
    "params": {
      "type": "object"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "editable": {
          "type": "boolean"
        }
      }
    }
  }
}
