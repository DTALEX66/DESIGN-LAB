{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/reference-set.json",
  "title": "ReferenceSet — 来源、权利、用途、hash、提取特征",
  "type": "object",
  "required": [
    "set_id",
    "sources",
    "purpose",
    "contentHash"
  ],
  "properties": {
    "set_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 8
    },
    "extractedFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rightsStatus": {
      "type": "string",
      "enum": [
        "reviewed",
        "reference-only",
        "unknown"
      ],
      "default": "reference-only"
    }
  },
  "additionalProperties": false
}
