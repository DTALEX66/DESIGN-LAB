{
  "name": "uiux-commercial-light",
  "version": "0.1.0",
  "components": [
    {
      "id": "app-header",
      "name": "App Header",
      "variants": ["sticky-top", "with-back", "with-avatar"],
      "used_in": ["mobile-task-flow-golden", "ecommerce-pdp-checkout-golden", "settings-accessibility-golden"],
      "a11y": ["role banner", "h1 唯一"]
    },
    {
      "id": "status-timeline",
      "name": "Status Timeline",
      "variants": ["done", "current", "upcoming", "warn"],
      "used_in": ["mobile-task-flow-golden"],
      "a11y": ["ol 语义", "current 用 aria-current"]
    },
    {
      "id": "card",
      "name": "Surface Card",
      "variants": ["default", "elevated"],
      "used_in": ["b2b-backoffice-golden", "mobile-task-flow-golden", "ecommerce-pdp-checkout-golden"],
      "a11y": ["contrast border"]
    },
    {
      "id": "kpi-card",
      "name": "KPI Card",
      "variants": ["default", "trend"],
      "used_in": ["b2b-backoffice-golden"],
      "a11y": ["label + value 语义"]
    },
    {
      "id": "data-table",
      "name": "Data Table",
      "variants": ["sortable", "selectable", "responsive-scroll"],
      "used_in": ["b2b-backoffice-golden", "responsive-content-page-golden"],
      "a11y": ["th scope", "min-width + 横向滚动防压扁"]
    },
    {
      "id": "bulk-action-bar",
      "name": "Bulk Action Bar",
      "variants": ["default", "danger"],
      "used_in": ["b2b-backoffice-golden"],
      "a11y": ["计数 aria-live"]
    },
    {
      "id": "chat-bubble",
      "name": "Chat Bubble",
      "variants": ["agent", "user"],
      "used_in": ["mobile-task-flow-golden"],
      "a11y": ["role log + aria-live"]
    },
    {
      "id": "quick-reply-bar",
      "name": "Quick Reply Bar",
      "variants": ["default"],
      "used_in": ["mobile-task-flow-golden"],
      "a11y": ["label 关联 input"]
    },
    {
      "id": "pdp-gallery",
      "name": "PDP Gallery",
      "variants": ["single", "carousel"],
      "used_in": ["ecommerce-pdp-checkout-golden"],
      "a11y": ["role img + aria-label"]
    },
    {
      "id": "price-block",
      "name": "Price Block",
      "variants": ["promo", "stock"],
      "used_in": ["ecommerce-pdp-checkout-golden"],
      "a11y": ["价格/原价语义区分"]
    },
    {
      "id": "variant-selector",
      "name": "Variant Selector",
      "variants": ["radio-group"],
      "used_in": ["ecommerce-pdp-checkout-golden"],
      "a11y": ["role radiogroup + aria-checked"]
    },
    {
      "id": "checkout-steps",
      "name": "Checkout Steps",
      "variants": ["stepper"],
      "used_in": ["ecommerce-pdp-checkout-golden"],
      "a11y": ["aria-current=step"]
    },
    {
      "id": "settings-nav",
      "name": "Settings Nav",
      "variants": ["horizontal-scroll", "vertical"],
      "used_in": ["settings-accessibility-golden"],
      "a11y": ["aria-current=page"]
    },
    {
      "id": "toggle-switch",
      "name": "Toggle Switch",
      "variants": ["checkbox-based"],
      "used_in": ["settings-accessibility-golden"],
      "a11y": ["原生 input + 可见 track/thumb"]
    },
    {
      "id": "slider-control",
      "name": "Slider Control",
      "variants": ["range"],
      "used_in": ["settings-accessibility-golden"],
      "a11y": ["label 关联 range input"]
    },
    {
      "id": "a11y-preview-panel",
      "name": "A11y Preview Panel",
      "variants": ["live-preview"],
      "used_in": ["settings-accessibility-golden"],
      "a11y": ["aria-live=polite"]
    },
    {
      "id": "toc-nav",
      "name": "Table of Contents",
      "variants": ["sticky-sidebar", "hidden-mobile"],
      "used_in": ["responsive-content-page-golden"],
      "a11y": ["nav + aria-label"]
    },
    {
      "id": "prose-body",
      "name": "Prose Body",
      "variants": ["article", "blockquote"],
      "used_in": ["responsive-content-page-golden"],
      "a11y": ["max-width 66ch", "blockquote 语义"]
    },
    {
      "id": "code-block",
      "name": "Code Block",
      "variants": ["scrollable"],
      "used_in": ["responsive-content-page-golden"],
      "a11y": ["overflow-x auto + tabindex"]
    }
  ]
}
