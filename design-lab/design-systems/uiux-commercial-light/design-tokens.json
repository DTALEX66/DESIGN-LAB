{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "uiux-commercial-light",
  "version": "0.1.0",
  "color": {
    "primary": {"$type": "color", "$value": "#2563EB"},
    "on-primary": {"$type": "color", "$value": "#FFFFFF"},
    "surface": {"$type": "color", "$value": "#FFFFFF"},
    "surface-muted": {"$type": "color", "$value": "#F4F6F9"},
    "background": {"$type": "color", "$value": "#F4F6F9"},
    "background-dark": {"$type": "color", "$value": "#0E1116"},
    "text": {"$type": "color", "$value": "#0F172A"},
    "text-dim": {"$type": "color", "$value": "#64748B"},
    "success": {"$type": "color", "$value": "#059669"},
    "warning": {"$type": "color", "$value": "#F5A623"},
    "danger": {"$type": "color", "$value": "#DC2626"},
    "border": {"$type": "color", "$value": "#E2E8F0"}
  },
  "dimension": {
    "radius-sm": {"$type": "dimension", "$value": "6px"},
    "radius-md": {"$type": "dimension", "$value": "10px"},
    "radius-lg": {"$type": "dimension", "$value": "14px"},
    "space-1": {"$type": "dimension", "$value": "4px"},
    "space-2": {"$type": "dimension", "$value": "8px"},
    "space-3": {"$type": "dimension", "$value": "12px"},
    "space-4": {"$type": "dimension", "$value": "16px"},
    "space-5": {"$type": "dimension", "$value": "24px"},
    "space-6": {"$type": "dimension", "$value": "32px"}
  },
  "typography": {
    "display": {"$type": "typography", "$value": {"fontFamily": "system-ui", "fontSize": "34px", "fontWeight": 700, "lineHeight": 1.2}},
    "h1": {"$type": "typography", "$value": {"fontFamily": "system-ui", "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.3}},
    "h2": {"$type": "typography", "$value": {"fontFamily": "system-ui", "fontSize": "18px", "fontWeight": 600, "lineHeight": 1.35}},
    "body": {"$type": "typography", "$value": {"fontFamily": "system-ui", "fontSize": "15px", "fontWeight": 400, "lineHeight": 1.5}},
    "caption": {"$type": "typography", "$value": {"fontFamily": "system-ui", "fontSize": "13px", "fontWeight": 400, "lineHeight": 1.45}}
  },
  "motion": {
    "duration-fast": {"$type": "duration", "$value": "120ms"},
    "duration-normal": {"$type": "duration", "$value": "200ms"},
    "reduce-enabled": {"$type": "boolean", "$value": true}
  }
}
