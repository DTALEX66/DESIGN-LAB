{
  "name": "perfect-fourth",
  "ratio": 1.333,
  "base_px": 12,
  "description": "Open, airy scale. Headings clearly separate from body. Good for content-led marketing, blogs, and editorial work.",
  "use_when": [
    "Marketing pages where headings should breathe",
    "Long-form content sites and blogs",
    "Landing pages with clear hero hierarchy"
  ],
  "sizes": [
    { "name": "xs",   "px": 12, "rem": 0.750, "line_height": 1.50, "letter_spacing_em": 0.005, "use": "captions, footnotes" },
    { "name": "sm",   "px": 15, "rem": 0.938, "line_height": 1.55, "letter_spacing_em": 0.002, "use": "secondary body, meta" },
    { "name": "base", "px": 18, "rem": 1.125, "line_height": 1.60, "letter_spacing_em": 0.000, "use": "body text" },
    { "name": "md",   "px": 24, "rem": 1.500, "line_height": 1.45, "letter_spacing_em": 0.000, "use": "lead paragraph" },
    { "name": "lg",   "px": 32, "rem": 2.000, "line_height": 1.30, "letter_spacing_em": -0.010, "use": "h4, card title" },
    { "name": "xl",   "px": 43, "rem": 2.688, "line_height": 1.20, "letter_spacing_em": -0.015, "use": "h3, section heading" },
    { "name": "2xl",  "px": 57, "rem": 3.563, "line_height": 1.10, "letter_spacing_em": -0.020, "use": "h2, marketing heading" },
    { "name": "3xl",  "px": 76, "rem": 4.750, "line_height": 1.05, "letter_spacing_em": -0.030, "use": "h1, hero, display" }
  ],
  "notes": "Display sizes need negative letter-spacing to look intentional. Watch for body text feeling too small relative to headings; bump base or `md` if it does."
}
