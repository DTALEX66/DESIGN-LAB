{
  "name": "golden",
  "ratio": 1.618,
  "base_px": 12,
  "description": "Dramatic display scale. Headings tower over body. Use only for editorial, luxury, hero-driven, or statement pages — too aggressive for general product UI.",
  "use_when": [
    "Editorial features and case studies",
    "Luxury, fashion, and statement marketing",
    "Hero-led landing pages where the hero IS the page"
  ],
  "sizes": [
    { "name": "xs",   "px": 12, "rem": 0.750, "line_height": 1.55, "letter_spacing_em": 0.005, "use": "captions, micro-meta" },
    { "name": "sm",   "px": 14, "rem": 0.875, "line_height": 1.55, "letter_spacing_em": 0.002, "use": "secondary body" },
    { "name": "base", "px": 18, "rem": 1.125, "line_height": 1.65, "letter_spacing_em": 0.000, "use": "body text" },
    { "name": "md",   "px": 29, "rem": 1.813, "line_height": 1.40, "letter_spacing_em": 0.000, "use": "lead paragraph, pull quote" },
    { "name": "lg",   "px": 47, "rem": 2.938, "line_height": 1.15, "letter_spacing_em": -0.015, "use": "h3, section heading" },
    { "name": "xl",   "px": 76, "rem": 4.750, "line_height": 1.05, "letter_spacing_em": -0.025, "use": "h2, marketing heading" },
    { "name": "2xl",  "px": 123, "rem": 7.688, "line_height": 1.00, "letter_spacing_em": -0.035, "use": "h1, display" },
    { "name": "3xl",  "px": 199, "rem": 12.438, "line_height": 0.95, "letter_spacing_em": -0.045, "use": "hero display, statement" }
  ],
  "notes": "Display sizes (xl and above) MUST use negative letter-spacing or they look loose and naive. Lock display weight at 600–700, never thin/300; thin at 200px reads as broken."
}
