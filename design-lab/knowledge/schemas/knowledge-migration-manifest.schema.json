{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/knowledge-migration-manifest.schema.json",
  "title": "Deferred Knowledge Migration Manifest",
  "type": "object",
  "required": ["manifestId", "sourceAuthority", "targetAuthority", "migrationStatus", "records"],
  "additionalProperties": false,
  "properties": {
    "manifestId": {"type": "string", "minLength": 1},
    "sourceAuthority": {"const": "temporary-design-lab"},
    "targetAuthority": {"const": "ArcheAxis-Knowledge-OS"},
    "migrationStatus": {"const": "deferred"},
    "records": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
