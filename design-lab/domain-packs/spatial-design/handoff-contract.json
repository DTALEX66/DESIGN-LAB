{
  "id": "spatial-design-handoff-contract",
  "version": "1.0.0",
  "display_name": "Spatial / Exhibition Design Domain Pack 可编辑交付合同",
  "deliverables": [
    {
      "name": "source-editable",
      "format": "skp/blend/ai",
      "editable": true,
      "required": true
    },
    {
      "name": "plan-export",
      "format": "pdf",
      "editable": false,
      "required": true
    },
    {
      "name": "material-schedule",
      "format": "json",
      "editable": true,
      "required": true
    },
    {
      "name": "handoff-package",
      "format": "zip",
      "editable": false,
      "required": true
    }
  ],
  "provenance": {
    "required": true,
    "fields": [
      "project_id",
      "artifact",
      "runtime",
      "agent",
      "source_refs",
      "steps",
      "evidence"
    ]
  },
  "versioning": {
    "scheme": "artifact version + sha256",
    "immutable": true
  },
  "acceptance": {
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
