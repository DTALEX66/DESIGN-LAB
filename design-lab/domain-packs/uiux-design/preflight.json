{
  "id": "uiux-preflight",
  "version": "1.0.0",
  "display_name": "UI/UX 生产预检",
  "required_checks": [
    {"id": "semantic-structure", "severity": "blocker", "tool": "axe-core"},
    {"id": "keyboard-complete", "severity": "blocker", "tool": "manual-keystroke"},
    {"id": "wcag-contrast", "severity": "high", "tool": "axe-core"},
    {"id": "responsive-320-375-414-768", "severity": "high", "tool": "browser-viewports"},
    {"id": "no-horizontal-overflow", "severity": "blocker", "tool": "browser-viewports"},
    {"id": "reduced-motion", "severity": "high", "tool": "axe-core"},
    {"id": "asset-licenses", "severity": "blocker", "tool": "source-registry"},
    {"id": "performance-budget", "severity": "medium", "tool": "lighthouse"},
    {"id": "form-labeling", "severity": "blocker", "tool": "axe-core"},
    {"id": "error-identification", "severity": "high", "tool": "manual-task-flow"}
  ],
  "deliverable_formats": ["html", "pdf", "zip", "figma-adaptable"],
  "provenance_required": true,
  "rights_required": true
}
