{
  "id": "uiux-handoff-contract",
  "version": "1.0.0",
  "display_name": "UI/UX 可编辑交付合同",
  "deliverables": [
    {"name": "source-html", "format": "html", "editable": true, "required": true},
    {"name": "design-tokens", "format": "dtcg-json", "editable": true, "required": true},
    {"name": "component-inventory", "format": "json", "editable": true, "required": true},
    {"name": "design-md", "format": "markdown", "editable": true, "required": true},
    {"name": "handoff-package", "format": "zip", "editable": false, "required": true}
  ],
  "provenance": {
    "required": true,
    "fields": ["project_id", "artifact", "runtime", "agent", "source_refs", "steps", "evidence"]
  },
  "versioning": {"scheme": "artifact version + sha256", "immutable": true},
  "acceptance": {
    "axe_critical_serious": 0,
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
