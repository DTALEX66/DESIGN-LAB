{
  "id": "uiux-quality-rubric",
  "version": "1.0.0",
  "display_name": "UI/UX 视觉与可用性 Rubric",
  "scoring": {"scale": "0-100", "pass_threshold": 82},
  "axes": [
    {
      "id": "hierarchy",
      "title": "信息层级与视觉节奏",
      "weight": 20,
      "criteria": [
        "主/次/辅层级清晰，无平铺表单感",
        "节奏与间距系统一致",
        "状态（normal/active/error/disabled）可区分"
      ]
    },
    {
      "id": "craft",
      "title": "细节与完成度",
      "weight": 20,
      "criteria": [
        "字体、圆角、描边、阴影符合设计系统",
        "图标与文本对齐精确",
        "无像素级错位或未完成态"
      ]
    },
    {
      "id": "usability",
      "title": "可用性与任务流",
      "weight": 25,
      "criteria": [
        "核心任务 3 步内可达",
        "键盘路径完整（Tab/Enter/Esc/方向键）",
        "错误识别与恢复明确"
      ]
    },
    {
      "id": "accessibility",
      "title": "无障碍（WCAG AA）",
      "weight": 15,
      "criteria": [
        "Axe critical/serious = 0",
        "对比度、焦点可见、语义结构达标",
        "reduced-motion 处理"
      ]
    },
    {
      "id": "responsiveness",
      "title": "三视口适配",
      "weight": 10,
      "criteria": [
        "320/768/1280 均无横向溢出",
        "布局在断点间合理重排",
        "触控目标尺寸达标"
      ]
    },
    {
      "id": "enhancement",
      "title": "基线 vs 增强",
      "weight": 10,
      "criteria": [
        "增强版在视觉/交互上明显优于基线",
        "偏好率 ≥70%（盲测）",
        "增强不破坏锁定项"
      ]
    }
  ]
}
