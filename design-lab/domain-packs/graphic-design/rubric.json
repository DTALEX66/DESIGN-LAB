{
  "id": "graphic-design-quality-rubric",
  "version": "1.0.0",
  "display_name": "Graphic Design Domain Pack Rubric",
  "scoring": {
    "scale": "0-100",
    "pass_threshold": 82
  },
  "axes": [
    {
      "id": "composition",
      "title": "构图与平衡",
      "weight": 20,
      "criteria": [
        "主视觉平衡",
        "留白与节奏",
        "元素无冲突"
      ]
    },
    {
      "id": "hierarchy",
      "title": "信息层级",
      "weight": 20,
      "criteria": [
        "核心信息一眼可读",
        "CTA 显著",
        "阅读路径清晰"
      ]
    },
    {
      "id": "typography",
      "title": "字体与可读性",
      "weight": 15,
      "criteria": [
        "字号/行距合理",
        "无拥挤溢出",
        "字体规则一致"
      ]
    },
    {
      "id": "color",
      "title": "色彩",
      "weight": 10,
      "criteria": [
        "对比度达标",
        "品牌色无偏差",
        "色域正确"
      ]
    },
    {
      "id": "message",
      "title": "商业沟通",
      "weight": 15,
      "criteria": [
        "目标信息优先级匹配",
        "受众语言",
        "无歧义"
      ]
    },
    {
      "id": "production",
      "title": "生产正确性",
      "weight": 10,
      "criteria": [
        "尺寸/DPI/出血",
        "格式正确",
        "无 missing font"
      ]
    },
    {
      "id": "enhancement",
      "title": "方案增强",
      "weight": 10,
      "criteria": [
        "优于基线",
        "偏好率≥70%",
        "不破坏锁定项"
      ]
    }
  ]
}
