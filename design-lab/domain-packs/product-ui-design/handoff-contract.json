{
  "id": "product-ui-design-handoff-contract",
  "version": "1.0.0",
  "display_name": "Product UI Design Domain Pack 可编辑交付合同",
  "deliverables": [
    {
      "name": "source-html",
      "format": "html",
      "editable": true,
      "required": true
    },
    {
      "name": "design-tokens",
      "format": "dtcg-json",
      "editable": true,
      "required": true
    },
    {
      "name": "component-inventory",
      "format": "json",
      "editable": true,
      "required": true
    },
    {
      "name": "handoff-package",
      "format": "zip",
      "editable": false,
      "required": true
    }
  ],
  "provenance": {
    "required": true,
    "fields": [
      "project_id",
      "artifact",
      "runtime",
      "agent",
      "source_refs",
      "steps",
      "evidence"
    ]
  },
  "versioning": {
    "scheme": "artifact version + sha256",
    "immutable": true
  },
  "acceptance": {
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
