{
  "id": "three-d-design-handoff-contract",
  "version": "1.0.0",
  "display_name": "3D Design Domain Pack 可编辑交付合同",
  "deliverables": [
    {
      "name": "source-scene",
      "format": "blend/max",
      "editable": true,
      "required": true
    },
    {
      "name": "model-export",
      "format": "fbx/gltf",
      "editable": false,
      "required": true
    },
    {
      "name": "render-export",
      "format": "png/exr",
      "editable": false,
      "required": true
    },
    {
      "name": "handoff-package",
      "format": "zip",
      "editable": false,
      "required": true
    }
  ],
  "provenance": {
    "required": true,
    "fields": [
      "project_id",
      "artifact",
      "runtime",
      "agent",
      "source_refs",
      "steps",
      "evidence"
    ]
  },
  "versioning": {
    "scheme": "artifact version + sha256",
    "immutable": true
  },
  "acceptance": {
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
