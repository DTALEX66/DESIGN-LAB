{
  "id": "ecommerce-design-quality-rubric",
  "version": "1.0.0",
  "display_name": "E-commerce Design Domain Pack Rubric",
  "scoring": {
    "scale": "0-100",
    "pass_threshold": 82
  },
  "axes": [
    {
      "id": "product-fidelity",
      "title": "产品主体忠实度",
      "weight": 20,
      "criteria": [
        "产品轮廓/标签/logo 与真实一致",
        "关键品牌区域未被重绘",
        "光影方向一致"
      ]
    },
    {
      "id": "communication",
      "title": "商业沟通",
      "weight": 20,
      "criteria": [
        "核心卖点显著",
        "CTA 清晰",
        "信息优先级匹配 campaign goal"
      ]
    },
    {
      "id": "hierarchy",
      "title": "信息层级",
      "weight": 15,
      "criteria": [
        "价格/卖点/CTA 层级",
        "无信息拥挤",
        "阅读路径"
      ]
    },
    {
      "id": "brand",
      "title": "品牌一致性",
      "weight": 15,
      "criteria": [
        "品牌色/字体一致",
        "模板规范",
        "无自创偏离"
      ]
    },
    {
      "id": "craft",
      "title": "细节与完成度",
      "weight": 10,
      "criteria": [
        "边缘/合成无瑕疵",
        "无假文字",
        "无 AI 味"
      ]
    },
    {
      "id": "production",
      "title": "生产正确性",
      "weight": 10,
      "criteria": [
        "尺寸/比例/格式",
        "文件大小预算",
        "安全文本区"
      ]
    },
    {
      "id": "enhancement",
      "title": "方案增强",
      "weight": 10,
      "criteria": [
        "优于基线",
        "偏好率≥70%",
        "不破坏锁定项"
      ]
    }
  ]
}
