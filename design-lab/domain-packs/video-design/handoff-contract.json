{
  "id": "video-design-handoff-contract",
  "version": "1.0.0",
  "display_name": "Video Design Domain Pack 可编辑交付合同",
  "deliverables": [
    {
      "name": "project-file",
      "format": "prproj",
      "editable": true,
      "required": true
    },
    {
      "name": "render-export",
      "format": "mp4",
      "editable": false,
      "required": true
    },
    {
      "name": "caption-file",
      "format": "srt",
      "editable": true,
      "required": true
    },
    {
      "name": "handoff-package",
      "format": "zip",
      "editable": false,
      "required": true
    }
  ],
  "provenance": {
    "required": true,
    "fields": [
      "project_id",
      "artifact",
      "runtime",
      "agent",
      "source_refs",
      "steps",
      "evidence"
    ]
  },
  "versioning": {
    "scheme": "artifact version + sha256",
    "immutable": true
  },
  "acceptance": {
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
