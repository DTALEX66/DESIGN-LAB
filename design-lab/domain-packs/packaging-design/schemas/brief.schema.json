{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-lab.local/schemas/domain-packs/packaging-design-brief.schema.json",
  "title": "Packaging Design Domain Pack Brief",
  "type": "object",
  "required": [
    "project_id",
    "objective",
    "audience",
    "deliverables",
    "constraints"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "format"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "editable_required": {
            "type": "boolean"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
