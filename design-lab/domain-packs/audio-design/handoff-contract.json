{
  "id": "audio-design-handoff-contract",
  "version": "1.0.0",
  "display_name": "Audio Design Domain Pack 可编辑交付合同",
  "deliverables": [
    {
      "name": "project-file",
      "format": "aep/pr",
      "editable": true,
      "required": true
    },
    {
      "name": "stems",
      "format": "wav",
      "editable": true,
      "required": true
    },
    {
      "name": "master-export",
      "format": "wav/mp3",
      "editable": false,
      "required": true
    },
    {
      "name": "handoff-package",
      "format": "zip",
      "editable": false,
      "required": true
    }
  ],
  "provenance": {
    "required": true,
    "fields": [
      "project_id",
      "artifact",
      "runtime",
      "agent",
      "source_refs",
      "steps",
      "evidence"
    ]
  },
  "versioning": {
    "scheme": "artifact version + sha256",
    "immutable": true
  },
  "acceptance": {
    "human_score_min": 82,
    "enhancement_preference_min": 70
  }
}
