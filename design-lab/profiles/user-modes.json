{
  "$schema": "../schemas/user-modes.schema.json",
  "schemaVersion": "design-lab/user-modes/v1",
  "source": "project-memory/USER_MODES.md",
  "modes": [
    {
      "id": "guided",
      "user": "小白、新手",
      "disclosure": "low",
      "control": "low",
      "value": "Brief 向导、安全默认值、逐步解释、模板、版权和生产防错",
      "safeDefaults": true,
      "highRiskHidden": true
    },
    {
      "id": "copilot",
      "user": "职业设计师",
      "disclosure": "medium",
      "control": "medium",
      "value": "参考 DNA、三方向、Token/组件、批量变体、跨格式、精修、预检",
      "safeDefaults": false,
      "highRiskHidden": false
    },
    {
      "id": "director",
      "user": "资深设计师、艺术指导",
      "disclosure": "high",
      "control": "high",
      "value": "自定义 Rubric、方向评审、局部锁定、人工覆盖、版本比较、回退",
      "safeDefaults": false,
      "highRiskHidden": false
    },
    {
      "id": "method",
      "user": "大师、研究者、教育者",
      "disclosure": "high",
      "control": "high",
      "value": "有来源的方法拆解、匿名转译、反模仿、专家校对、版本演进",
      "safeDefaults": false,
      "highRiskHidden": false
    },
    {
      "id": "production",
      "user": "品牌方、客户、生产方",
      "disclosure": "medium",
      "control": "medium",
      "value": "Brief/审批追踪、品牌一致性、权利 BOM、规格、可编辑交付、签收",
      "safeDefaults": true,
      "highRiskHidden": false
    }
  ],
  "constraints": [
    "同一能力引擎提供不同披露与控制强度，不创建多套产品",
    "大师能力不得做成姓名风格按钮：最终生成指令不得含大师姓名，不得复制签名元素",
    "人工方向、取舍和最终批准权在所有模式下保留"
  ]
}
