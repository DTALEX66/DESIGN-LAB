{
  "schemaVersion": "packages/capabilities/reconstruction-performance/v1",
  "measurementStatus": "UNMEASURED",
  "measurementPolicy": {
    "corpus": "six-rights-cleared-golden-cases",
    "coldSamplesPerProfileMinimum": 3,
    "warmSamplesPerProfileMinimum": 5,
    "requiredFields": ["hardwareId", "sampleCount", "p50Ms", "p95Ms", "peakVramMiB", "peakWorkingSetMiB"],
    "resolutionScaleRequired": 1.0,
    "qualityMetricsMustRemainUnchangedAcrossFallbacks": true
  },
  "routing": {
    "gpuOptionalProviderMinimumVramMiB": 7500,
    "tileSizeBelow10000MiB": 1024,
    "tileSizeAtOrAbove10000MiB": 2048,
    "requiredProviders": ["geometry", "paddleocr", "layerd", "vtracer"],
    "largeModelsExcludedUntilMeasured": ["omnisvg-4b", "qwen-image-layered"]
  },
  "measurements": []
}
