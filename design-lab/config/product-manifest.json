{
  "$schema": "../schemas/product-manifest.schema.json",
  "schemaVersion": "design-lab/product-manifest/v1",
  "product": {
    "id": "design-lab",
    "name": "DESIGN-LAB",
    "version": "1.0.0",
    "positioning": "Agent-platform-neutral design intelligence and production laboratory for professional visual design with commercial production preflight and editable delivery: research, compliance knowledge, design methods, domain capability, visual quality, tool adaptation, production preflight, editable handoff, and an evidence system organized as composable, executable, verifiable, rollback-safe design capability loops. Host-native; no default host, agent, or model binding.",
    "productDefinition": "project-memory/PRODUCT_DEFINITION.md",
    "boundaryContract": "project-memory/BOUNDARY_CONTRACT.md",
    "userModes": "design-lab/profiles/user-modes.json",
    "objectModel": "design-lab/config/object-model.json",
    "neutralityPolicy": {
      "modelNeutral": "no single model is baked in as the product capability; controlled Agent/media adapters",
      "styleNeutral": "no Apple/black-gold/tech-blue/HUD/master style is a global default",
      "domainNeutral": "public kernel serves brand, graphic, ui-ux, editorial, ecommerce, packaging, spatial, exhibition, 3D, motion, video, game visual",
      "platformNeutral": "any design AGENT platform may act as host/entry; no default host, agent, or model is bound in the product contract",
      "versionNeutral": "no host or tool version is pinned as a product requirement"
    },
    "rightsPolicy": {
      "mode": "rights-governed",
      "defaultUnknown": "reference-only",
      "requires": [
        "SourceRecord per source/asset/font/model/standard/reference",
        "license or rights status with allowed usage",
        "SHA-256 content hash where applicable",
        "human review for production eligibility"
      ]
    },
    "nonGoals": [
      "replace Open Design app, daemon, Studio/canvas, or model routing",
      "build a second canvas, chat client, model gateway, or general SaaS backend",
      "copy protected master signatures, branded assets, fonts, logos, images, or layouts",
      "vendor unreviewed third-party repositories, model weights, fonts, installers, credentials, or private runtime state",
      "claim runtime or commercial readiness from static files alone",
      "make MiniGame operational/advertising/monetization the platform mainline"
    ]
  },
  "evidencePolicy": {
    "levels": [
      "E0",
      "E1",
      "E2",
      "E3",
      "E4",
      "E5"
    ],
    "states": [
      "NOT_RUN",
      "PASS",
      "FAIL",
      "BLOCKED",
      "UNVERIFIED",
      "SKIPPED_OPTIONAL"
    ],
    "runtimeReadyRequires": [
      "host runtime registration via AdapterRecord",
      "runtime ID/version read-back",
      "minimal task execution",
      "artifact and provenance read-back",
      "failure/recovery evidence"
    ]
  },
  "directoryRoles": [
    {
      "path": "design-lab/core/",
      "role": "neutral objects, contracts and policy"
    },
    {
      "path": "design-lab/intelligence/",
      "role": "intake, direction, design system, critique"
    },
    {
      "path": "design-lab/config/",
      "role": "machine-readable product, capability and execution policy SSOT"
    },
    {
      "path": "design-lab/schemas/",
      "role": "neutral contracts for brief, direction, state, scoring, preflight, delivery, provenance, release-evidence and manifest validation"
    },
    {
      "path": "design-lab/adapters/",
      "role": "host/agent/tool/model adapters with AdapterRecord contracts; no default binding"
    },
    {
      "path": "design-lab/atoms/",
      "role": "bounded testable internal capabilities"
    },
    {
      "path": "design-lab/scenarios/",
      "role": "ordered visual design pipelines"
    },
    {
      "path": "design-lab/bundles/",
      "role": "public composites: commercial-design-core, visual-quality-core, production-handoff"
    },
    {
      "path": "design-lab/knowledge/",
      "role": "governed sources, methods, standards and registries"
    },
    {
      "path": "design-lab/research/",
      "role": "style lineages, visual benchmarks, domain studies, experiment records"
    },
    {
      "path": "design-lab/evals/",
      "role": "rubrics, baselines, regression cases and quality gates"
    },
    {
      "path": "design-lab/domain-packs/",
      "role": "professional domain packs per Domain Pack Spec"
    },
    {
      "path": "design-lab/quality/",
      "role": "visual quality rubrics, juries and regression"
    },
    {
      "path": "design-lab/production/",
      "role": "preflight, handoff, provenance and rollback"
    },
    {
      "path": "design-lab/templates/",
      "role": "reusable brief, method, rubric and handoff templates"
    },
    {
      "path": "design-lab/profiles/",
      "role": "domain and production preflight profiles"
    },
    {
      "path": "design-lab/assets/",
      "role": "asset-pack manifests and reviewed local reference assets"
    },
    {
      "path": "design-system/",
      "role": "absorbed DESIGN.md and token reference material (neutral protocol assets)"
    },
    {
      "path": "minigame-runtime/",
      "role": "game-visual design fixture / runtime reference; not product"
    },
    {
      "path": "project-memory/",
      "role": "product definition, architecture, boundary contract, roadmap, object model, user modes, neutrality policy, evidence policy, adapter policy and history"
    }
  ],
  "capabilityFamilies": [
    {
      "id": "design-intelligence",
      "title": "Brief, direction, design system and critique intelligence",
      "paths": [
        "design-lab/intelligence/",
        "design-lab/atoms/brief-normalizer/",
        "design-lab/atoms/source-intake-gate/"
      ],
      "minimumEvidence": "E2",
      "domain": "all",
      "adapters": [],
      "standards": [
        "design-brief schema",
        "design-direction schema"
      ],
      "license": "MIT",
      "benchmark": "commercial-design-core",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "professional-visual-domains",
      "title": "Brand, graphic, UIUX, ecommerce, editorial, packaging, spatial, exhibition, 3D, motion, video, game visual",
      "paths": [
        "design-lab/domain-packs/",
        "design-lab/scenarios/",
        "design-lab/profiles/"
      ],
      "minimumEvidence": "E2",
      "domain": "all",
      "adapters": [],
      "standards": [
        "domain pack spec"
      ],
      "license": "MIT",
      "benchmark": "domain benchmark cases",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "visual-quality",
      "title": "Visual quality, design feeling and anti-AI-slop engine",
      "paths": [
        "design-lab/quality/",
        "design-lab/bundles/visual-quality-core/",
        "design-lab/evals/rubrics/visual-quality-core.rubric.json",
        "design-lab/knowledge/visual-quality/",
        "design-lab/scripts/score_visual_quality.py",
        "design-lab/scripts/score_design_critique.py",
        "design-lab/scripts/compare_visual_iterations.py",
        "design-lab/scripts/verify_visual_scoring_v3.py"
      ],
      "minimumEvidence": "E2",
      "domain": "all",
      "adapters": [],
      "standards": [
        "visual-quality-report schema",
        "human jury protocol"
      ],
      "license": "MIT",
      "benchmark": "12 benchmark briefs",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "creative-toolchain",
      "title": "Host / agent / creative-tool adapters",
      "paths": [
        "design-lab/adapters/"
      ],
      "minimumEvidence": "E1",
      "domain": "all",
      "adapters": [],
      "standards": [
        "adapter-contract schema",
        "AdapterRecord"
      ],
      "license": "MIT",
      "benchmark": "adapter registry",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "production-handoff",
      "title": "Production preflight and editable delivery",
      "paths": [
        "design-lab/production/",
        "design-lab/atoms/commercial-preflight/",
        "design-lab/atoms/delivery-packager/",
        "design-lab/schemas/preflight.schema.json",
        "design-lab/schemas/design-handoff.schema.json",
        "design-lab/schemas/provenance.schema.json"
      ],
      "minimumEvidence": "E2",
      "domain": "all",
      "adapters": [],
      "standards": [
        "preflight schema",
        "handoff contract",
        "provenance schema"
      ],
      "license": "MIT",
      "benchmark": "production handoff cases",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "research-evidence",
      "title": "Research, evidence and benchmarks",
      "paths": [
        "design-lab/knowledge/sources/",
        "design-lab/research/",
        "design-lab/evals/",
        "design-lab/scripts/verify_source_registry.py"
      ],
      "minimumEvidence": "E1",
      "domain": "governance",
      "adapters": [],
      "standards": [
        "SourceRecord",
        "E0-E5 evidence",
        "SPDX"
      ],
      "license": "MIT (original); reference records not vendored",
      "benchmark": "source registry",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    },
    {
      "id": "release-evidence",
      "title": "Review, exact-SHA CI and release evidence",
      "paths": [
        ".github/workflows/",
        "design-lab/evals/",
        "design-lab/config/capability-status.json",
        "design-lab/schemas/release-evidence.schema.json",
        "design-lab/scripts/verify_release_evidence.py"
      ],
      "minimumEvidence": "E4",
      "domain": "governance",
      "adapters": [],
      "standards": [
        "release-evidence schema",
        "exact-SHA CI"
      ],
      "license": "MIT",
      "benchmark": "release evidence contract",
      "owner": "DTALEX66",
      "lastVerified": "2026-08-13"
    }
  ],
  "entrypoints": {
    "human": [
      "README.md",
      "project-memory/PRODUCT_DEFINITION.md",
      "project-memory/ARCHITECTURE.md",
      "project-memory/BOUNDARY_CONTRACT.md",
      "project-memory/ROADMAP.md"
    ],
    "machine": [
      "design-lab/config/product-manifest.json",
      "design-lab/config/capability-status.json",
      "design-lab/config/object-model.json",
      "design-lab/profiles/user-modes.json"
    ],
    "verification": [
      "design-lab/scripts/verify_design_lab.py",
      "design-lab/scripts/verify_product_manifest_v3.py",
      "design-lab/scripts/verify_runtime_contracts_v3.py",
      "design-lab/scripts/verify_visual_scoring_v3.py",
      "design-lab/scripts/verify_release_evidence.py",
      "design-lab/scripts/verify_source_registry.py",
      "design-lab/scripts/verify_v2_protocols.py",
      "design-lab/scripts/verify_visual_quality_v21.py"
    ]
  },
  "safetyBoundaries": {
    "forbiddenRoots": [
      "E:/"
    ],
    "forbiddenSecrets": [
      ".env",
      "auth.json",
      "token",
      "credential",
      "cookie",
      "private key"
    ],
    "requiresExplicitAuthorization": [
      "live apply to main",
      "commit",
      "push",
      "pull request",
      "merge",
      "ruleset",
      "release"
    ]
  }
}
