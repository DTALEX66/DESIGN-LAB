{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-session Tool Write Authorization",
  "type": "object",
  "required": ["authorizationId", "tool", "fixtureScope", "grantedBy", "expiresAt", "allowedOperations"],
  "additionalProperties": false,
  "properties": {
    "authorizationId": {"type": "string", "minLength": 1},
    "tool": {"enum": ["photoshop", "illustrator", "eagle"]},
    "fixtureScope": {"type": "string", "minLength": 1},
    "grantedBy": {"type": "string", "minLength": 1},
    "expiresAt": {"type": "string", "format": "date-time"},
    "allowedOperations": {"type": "array", "minItems": 1, "items": {"enum": ["create", "import", "export", "reopen", "readback", "rollback", "delete-test-asset"]}}
  }
}
