{
  "project": "DESIGN-LAB",
  "schema": "design-lab/ui-tokens/v1",
  "authority": "UI套件 B04/L4 DESIGN-LAB_design_tokens.json + B07 theme/tokens.css（双源一致）；视觉铁律：黑/深灰 + 白 + Electric Blue，紫色只进创意内容不作系统主色",
  "consumers": [
    "apps/workbench/style.css（:root 变量）",
    "后续 12 页 IA 与组件系统（B07 component-registry.json）"
  ],
  "colors": {
    "bg": "#060A14",
    "surface": "#0D1221",
    "surface2": "#11182A",
    "border": "#213D66",
    "primary": "#316CFF",
    "secondary": "#4BAFFF",
    "text": "#F5F7FC",
    "muted": "#9AA3B8",
    "success": "#2FC58D",
    "warning": "#F4B942",
    "error": "#F05252",
    "info": "#4BAFFF"
  },
  "radius": { "sm": 4, "md": 8, "lg": 14, "xl": 20 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64 },
  "typography": { "display": 48, "h1": 36, "h2": 28, "h3": 22, "body": 18, "caption": 14 },
  "motion": { "fast": "120ms", "base": "180ms", "slow": "280ms", "emphasis": "420ms" },
  "density": { "comfortable": 68, "default": 56, "compact": 44 },
  "theme_isolation": {
    "mount": "html[data-theme='design_lab']（B07 治理：主题值只经 CSS 变量访问；跨项目不共享品牌皮肤）",
    "shared_with_siblings": ["组件 API", "可访问规则", "交互态", "动效节奏", "断点", "键盘约定", "页面状态契约", "工程目录规范"],
    "not_shared_with_siblings": ["品牌色板", "Logo", "产品导航", "领域术语", "内容层级", "视觉个性"]
  }
}
