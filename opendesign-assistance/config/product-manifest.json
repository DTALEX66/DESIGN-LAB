{
  "$schema": "../schemas/product-manifest.schema.json",
  "schemaVersion": "open-design-assistance/product-manifest/v1",
  "product": {
    "id": "open-design-assistance",
    "name": "OPEN-DESIGN-Assistance",
    "version": "4.2.0",
    "positioning": "Agent-platform-neutral Design Capability & Visual Quality Enhancement Layer: model-neutral, style-neutral, domain-neutral, platform-neutral, rights-safe, with commercial production preflight and editable delivery. Current reference host / primary entry: Open Design (version-agnostic).",
    "productDefinition": "project-memory/PRODUCT_DEFINITION_V42.md",
    "boundaryContract": "project-memory/BOUNDARY_CONTRACT_V42.md",
    "userModes": "opendesign-assistance/profiles/user-modes.json",
    "objectModel": "opendesign-assistance/config/object-model.json",
    "primaryRuntime": "Open Design (current reference host; any design AGENT platform)",
    "agentRuntimes": [
      "Hermes",
      "Codex",
      "compatible local CLI agents"
    ],
    "fiveNeutralities": {
      "modelNeutral": "no single model is baked in as the product capability; controlled Agent/media adapters",
      "styleNeutral": "no Apple/black-gold/tech-blue/HUD/master style is a global default",
      "domainNeutral": "public kernel serves UI/UX, graphic, brand, ecommerce, spatial, 3D, motion, video, audio, game",
      "toolNeutral": "any design AGENT platform may act as host/entry (Open Design is the current reference host, version-agnostic); downstream adapts Figma/Penpot/Blender/FFmpeg etc",
      "rightsNeutral": "every source/asset/font/model/standard/reference has a rights status and usage mode"
    },
    "nonGoals": [
      "replace Open Design app, daemon, Studio/canvas, or model routing",
      "copy protected master signatures, branded assets, fonts, logos, images, or layouts",
      "vendor unreviewed third-party repositories, model weights, fonts, installers, credentials, or private runtime state",
      "claim runtime or commercial readiness from static files alone",
      "make MiniGame operational/advertising/monetization the platform mainline"
    ]
  },
  "evidencePolicy": {
    "levels": [
      "E0",
      "E1",
      "E2",
      "E3",
      "E4",
      "E5"
    ],
    "states": [
      "NOT_RUN",
      "PASS",
      "FAIL",
      "BLOCKED",
      "UNVERIFIED",
      "SKIPPED_OPTIONAL"
    ],
    "runtimeReadyRequires": [
      "Open Design runtime registration",
      "runtime ID/version read-back",
      "minimal task execution",
      "artifact and provenance read-back",
      "failure/recovery evidence"
    ]
  },
  "directoryRoles": [
    {
      "path": "opendesign-assistance/config/",
      "role": "machine-readable product, capability and execution policy SSOT"
    },
    {
      "path": "opendesign-assistance/schemas/",
      "role": "contracts for brief, direction, state, scoring, preflight, delivery, provenance, release-evidence and manifest validation"
    },
    {
      "path": "opendesign-assistance/plugins/",
      "role": "compatible Open Design skill surfaces (kept as adapters, not separate product entries)"
    },
    {
      "path": "opendesign-assistance/atoms/",
      "role": "bounded testable internal capabilities"
    },
    {
      "path": "opendesign-assistance/scenarios/",
      "role": "ordered commercial design and visual-quality pipelines"
    },
    {
      "path": "opendesign-assistance/bundles/",
      "role": "the three public entry points: commercial-design-core, visual-quality-core, production-handoff"
    },
    {
      "path": "opendesign-assistance/knowledge/",
      "role": "source-grounded professional design, style, master-method, standards and governance rules"
    },
    {
      "path": "opendesign-assistance/evals/",
      "role": "rubrics, baselines, regression cases and quality gates"
    },
    {
      "path": "opendesign-assistance/profiles/",
      "role": "domain and production preflight profiles"
    },
    {
      "path": "opendesign-assistance/research/",
      "role": "source registries, master registries, style lineages and visual-quality research"
    },
    {
      "path": "opendesign-assistance/design-systems/",
      "role": "Open Design-native design-system packages (reference, not global default)"
    },
    {
      "path": "opendesign-assistance/assets/",
      "role": "asset-pack manifests and reviewed local reference assets"
    },
    {
      "path": "opendesign-assistance/exports/",
      "role": "self-contained generated examples and handoff artifacts"
    },
    {
      "path": "opendesign-assistance/domain-packs/",
      "role": "professional domain packs per Domain Pack Spec"
    },
    {
      "path": "design-system/",
      "role": "absorbed DESIGN.md and token reference material"
    },
    {
      "path": "minigame-runtime/",
      "role": "reference product + cross-media benchmark; isolated, not primary product flow"
    },
    {
      "path": "project-memory/",
      "role": "project definition, migration and decision record"
    }
  ],
  "capabilityFamilies": [
