{
  "$schema": "https://open-design-assistance.local/schemas/object-model.schema.json",
  "schemaVersion": "open-design-assistance/object-model/v1",
  "objects": [
    {
      "id": "project",
      "lifecycle": {
        "stages": ["intake", "route", "research", "direction", "system", "execute", "critique", "preflight", "handoff", "approved"],
        "terminalStates": ["approved", "superseded", "cancelled"]
      },
      "versioning": {"scheme": "semver + iteration", "immutable": false},
      "rights": {"licenseStatus": "owned", "requiresReview": false},
      "references": {
        "outgoing": [
          {"target": "artifact", "relation": "produces"},
          {"target": "evidence", "relation": "documents"},
          {"target": "knowledge", "relation": "applies"}
        ]
      }
    },
    {
      "id": "knowledge",
      "lifecycle": {
        "stages": ["collected", "reviewed", "verified", "runtime-eligible", "retired"],
        "terminalStates": ["retired", "quarantined"]
      },
      "versioning": {"scheme": "registry version + maturity", "immutable": true},
      "rights": {"licenseStatus": "review-required", "requiresReview": true},
      "references": {
        "outgoing": [
          {"target": "project", "relation": "informs"},
          {"target": "evidence", "relation": "verified-by"}
        ]
      }
    },
    {
      "id": "evidence",
      "lifecycle": {
        "stages": ["recorded", "verified", "published", "expired"],
        "terminalStates": ["expired", "superseded"]
      },
      "versioning": {"scheme": "exact SHA + timestamp", "immutable": true},
      "rights": {"licenseStatus": "owned", "requiresReview": false},
      "references": {
        "outgoing": [
          {"target": "project", "relation": "proves"},
          {"target": "artifact", "relation": "hashes"},
          {"target": "knowledge", "relation": "validates"}
        ]
      }
    },
    {
      "id": "artifact",
      "lifecycle": {
        "stages": ["draft", "review", "approved", "delivered", "archived"],
        "terminalStates": ["delivered", "archived", "superseded"]
      },
      "versioning": {"scheme": "artifact version + sha256", "immutable": true},
      "rights": {"licenseStatus": "review-required", "requiresReview": true},
      "references": {
        "outgoing": [
          {"target": "project", "relation": "belongs-to"},
          {"target": "evidence", "relation": "provenance"}
        ]
      }
    }
  ]
}
