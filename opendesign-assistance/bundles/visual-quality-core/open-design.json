{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "visual-quality-core",
  "title": "Visual Quality Core",
  "version": "0.2.2",
  "description": "Evidence-aware master/studio research, deep style analysis, reference DNA, art direction, visual jury, realism QA and bounded finishing bundle.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "bundle",
    "visual-quality",
    "master-method"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "bundle",
    "mode": "bundle",
    "taskKind": "tune-collab",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "atoms": [
        "critique-theater",
        "media-image",
        "live-artifact",
        "file-read",
        "file-write"
      ],
      "assets": [
        "../../research/master-studies/MASTER_REGISTRY.json",
        "../../research/master-studies/ANCHOR_METHOD_CARDS.json",
        "../../research/style-lineages/STYLE_LINEAGES.json",
        "../../research/style-lineages/STYLE_ANALYSIS_CARDS.json"
      ]
    },
    "capabilities": [
      "prompt:inject",
      "pipeline:*",
      "fs:write",
      "media:image"
    ]
  }
}
