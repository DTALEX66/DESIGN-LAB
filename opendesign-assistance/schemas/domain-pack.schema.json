{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design-assistance.local/schemas/domain-pack.schema.json",
  "title": "OPEN-DESIGN-Assistance Domain Pack Spec V2",
  "description": "ODA4-0204. A compliant Domain Pack MUST contain all ten elements. Prompt-only packs fail.",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "display_name",
    "domain",
    "files",
    "size_bytes_budget",
    "dependencies"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "open-design-assistance/domain-pack/v2"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "size_bytes_budget": {"type": "integer", "minimum": 1},
    "size_bytes_current": {"type": "integer", "minimum": 0},
    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "files": {
      "type": "object",
      "required": [
        "manifest",
        "brief_schema",
        "scenario",
        "profile",
        "rubric",
        "preflight",
        "handoff_contract",
        "source_mapping",
        "benchmark_cases",
        "evidence_cards"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest": {"type": "string", "minLength": 1},
        "brief_schema": {"type": "string", "minLength": 1},
        "scenario": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "rubric": {"type": "string", "minLength": 1},
        "preflight": {"type": "string", "minLength": 1},
        "handoff_contract": {"type": "string", "minLength": 1},
        "source_mapping": {"type": "string", "minLength": 1},
        "benchmark_cases": {"type": "string", "minLength": 1},
        "evidence_cards": {"type": "string", "minLength": 1}
      }
    }
  }
}
