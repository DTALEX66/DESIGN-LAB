{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-design-assistance.local/schemas/adapter-contract.schema.json",
  "title": "OPEN-DESIGN-Assistance Tool Adapter Contract (ODA4-0206)",
  "type": "object",
  "required": ["adapter_id", "tool", "capabilities", "status", "mode"],
  "additionalProperties": false,
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "supported"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "supported": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["available", "missing", "process-isolated", "unsupported"]},
    "mode": {"enum": ["process-isolated", "in-process", "external-cli", "none"]},
    "license": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1}
  }
}
