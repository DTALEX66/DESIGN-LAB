{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/capability-status.json",
  "title": "Capability Evidence Record",
  "type": "object",
  "required": [
    "capability",
    "level",
    "evidence"
  ],
  "properties": {
    "capability": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "location"
        ],
        "properties": {
          "type": {
            "enum": [
              "file",
              "static-test",
              "runtime-log",
              "task-output",
              "human-acceptance"
            ]
          },
          "location": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "last_verified": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
