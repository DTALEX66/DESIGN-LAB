{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "reviewed_tree",
    "findings",
    "tree_unchanged"
  ],
  "properties": {
    "decision": {
      "enum": [
        "GO",
        "NO-GO",
        "BLOCKED"
      ]
    },
    "reviewed_tree": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "title",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "required_fix": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tree_unchanged": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
