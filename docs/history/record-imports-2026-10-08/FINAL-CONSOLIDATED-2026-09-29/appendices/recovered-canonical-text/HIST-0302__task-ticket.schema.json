{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-ticket.schema.json",
  "type": "object",
  "required": [
    "id",
    "phase",
    "title",
    "goal",
    "risk",
    "writer",
    "dependencies",
    "allowed_paths",
    "forbidden_paths",
    "outputs",
    "acceptance",
    "tests",
    "required_evidence_level"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OD-[0-9]{4}$"
    },
    "phase": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "goal": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "writer": {
      "enum": [
        "hermes",
        "codex-writer",
        "codex-reviewer"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
