{
  "schema_version": "3.0",
  "risk_order": [
    "low",
    "medium",
    "high",
    "critical"
  ],
  "forced_high_patterns": [
    ".github/**",
    "config/**",
    "**/schemas/**",
    "**/scripts/**",
    "**/open-design.json",
    "**/LICENSE*",
    "**/THIRD_PARTY*",
    "auth/**",
    "dependency/**",
    "migration/**",
    "delete/**",
    "packaging/**",
    "deployment/**"
  ],
  "forced_critical_operations": [
    "read_credentials",
    "write_outside_repo",
    "touch_E_drive",
    "delete_outside_repo",
    "force_push",
    "merge_main",
    "publish_release"
  ],
  "formula": "max(user_declared_risk, detected_risk)",
  "approval_required": [
    "live_apply",
    "commit",
    "push",
    "create_pr",
    "modify_ruleset",
    "merge",
    "release",
    "overwrite_conflict"
  ]
}
