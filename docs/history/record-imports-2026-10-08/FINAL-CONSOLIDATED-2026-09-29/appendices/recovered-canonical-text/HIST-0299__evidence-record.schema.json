{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "check_id",
    "status",
    "evidence_level",
    "started_at",
    "ended_at",
    "secret_free"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "check_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNVERIFIED",
        "SKIPPED_OPTIONAL"
      ]
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4",
        "E5"
      ]
    },
    "command": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "output_digest": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "head_sha": {
      "type": "string"
    },
    "tree_sha": {
      "type": "string"
    },
    "secret_free": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
