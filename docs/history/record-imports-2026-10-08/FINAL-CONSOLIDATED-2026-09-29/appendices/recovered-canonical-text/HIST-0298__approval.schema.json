{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "mission_digest",
    "risk",
    "allowed_paths",
    "approved_tree",
    "actions",
    "expires_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "mission_digest": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_tree": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "enum": [
          "live_apply",
          "commit",
          "push",
          "create_pr",
          "modify_ruleset",
          "merge",
          "release",
          "overwrite_conflict"
        ]
      }
    },
    "expires_at": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
