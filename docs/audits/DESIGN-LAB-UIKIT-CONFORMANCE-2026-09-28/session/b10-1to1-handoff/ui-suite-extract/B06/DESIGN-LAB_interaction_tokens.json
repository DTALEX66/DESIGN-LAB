{
  "project": "DESIGN-LAB",
  "hover": {
    "border": "secondary",
    "duration": "120ms"
  },
  "focus": {
    "ring": "2px",
    "offset": "2px",
    "color": "primary"
  },
  "pressed": {
    "duration": "80ms",
    "scale": 0.99
  },
  "drawer": {
    "duration": "280ms",
    "easing": "cubic-bezier(0.2,0,0,1)"
  },
  "modal": {
    "duration": "220ms",
    "backdrop_opacity": 0.62
  },
  "toast": {
    "duration": "4000ms",
    "stack_gap": 12
  },
  "keyboard": {
    "command_palette": "Cmd/Ctrl+K",
    "close": "Esc",
    "confirm": "Enter"
  },
  "responsive": {
    "tablet": 1024,
    "mobile": 767
  }
}